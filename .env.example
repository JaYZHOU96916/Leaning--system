APP_ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/academic_os.db

# Canvas API
CANVAS_BASE_URL=https://canvas.instructure.com/api/v1
CANVAS_API_TOKEN=
CANVAS_USER_AGENT=AcademicOS/0.1 (Canvas integration)

# A Fernet key used to encrypt tokens before persistent storage.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANVAS_ENCRYPTION_KEY=

# Canvas client resilience
CANVAS_REQUEST_TIMEOUT_SECONDS=30
CANVAS_MAX_RETRIES=3
CANVAS_MIN_RATE_LIMIT_SLEEP_SECONDS=0.25
CANVAS_MAX_RATE_LIMIT_SLEEP_SECONDS=8

# DDL alerts and scheduler
SCHEDULER_ENABLED=false
DDL_ALERT_POLL_INTERVAL_MINUTES=15
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=generic
ALERT_EMAIL_TO=

# Optional OpenAI-compatible flashcard generation
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
SNAPSHOTS_ROOT_DIR=./data/snapshots
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
