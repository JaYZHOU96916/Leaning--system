APP_ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/academic_os.db

# Canvas API
CANVAS_BASE_URL=https://canvas.instructure.com/api/v1
CANVAS_API_TOKEN=

# A Fernet key used to encrypt tokens before persistent storage.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANVAS_ENCRYPTION_KEY=

# Canvas client resilience
CANVAS_REQUEST_TIMEOUT_SECONDS=30
CANVAS_MAX_RETRIES=3
CANVAS_MIN_RATE_LIMIT_SLEEP_SECONDS=0.25
CANVAS_MAX_RATE_LIMIT_SLEEP_SECONDS=8

# DDL alerts and scheduler
SCHEDULER_ENABLED=false
DDL_ALERT_POLL_INTERVAL_MINUTES=15
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=generic
ALERT_EMAIL_TO=
